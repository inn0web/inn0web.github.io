1a:T5e9,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What does inn0web build?","acceptedAnswer":{"@type":"Answer","text":"Custom bots and automation systems, websites and landing pages, and Shopify stores. Each project is designed around your workflow, your tools and your customers."}},{"@type":"Question","name":"How much does a project cost?","acceptedAnswer":{"@type":"Answer","text":"Projects start from $120. Nothing is fixed-price: we look at the workflow or the pages you need, then quote for that scope before any work begins."}},{"@type":"Question","name":"Where are you based?","acceptedAnswer":{"@type":"Answer","text":"inn0web is based in the United Kingdom and works with clients remotely, wherever they are."}},{"@type":"Question","name":"How do we start?","acceptedAnswer":{"@type":"Answer","text":"Message us on WhatsApp or send a short brief. We map what you need, agree the scope and the price, and make the important parts tangible before the full build."}},{"@type":"Question","name":"Can a person approve what a bot does?","acceptedAnswer":{"@type":"Answer","text":"Yes. Approvals can sit before a reply, order, data change or other important action. We define what the system can do on its own and what needs review."}},{"@type":"Question","name":"Which tools can you connect?","acceptedAnswer":{"@type":"Answer","text":"We start with the APIs, webhooks and integrations your tools support. Access and platform rules are assessed during scoping."}}]}14:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1a"}}]
