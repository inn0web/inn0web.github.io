1b:T4cd,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"Custom bot development and workflow automation","url":"https://inn0web.com/bots","description":"Custom bots, AI agents and automations for lead handling, Instagram conversations, customer support, ecommerce and operations.","provider":{"@id":"https://inn0web.com/#organization"},"areaServed":"Worldwide","hasOfferCatalog":{"@type":"OfferCatalog","name":"Custom bot development and workflow automation","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Custom bot development"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"AI agents"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Workflow automation"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Instagram DM automation"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"TikTok Shop automation"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"System integrations"}}]}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://inn0web.com"},{"@type":"ListItem","position":2,"name":"Custom bot development and workflow automation","item":"https://inn0web.com/bots"}]}]}18:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}]
1c:T693,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Do you sell these four bots as packages?","acceptedAnswer":{"@type":"Answer","text":"Each system is built around your workflow. The four examples show the kinds of triggers, decisions, integrations and human controls we can design."}},{"@type":"Question","name":"Can a person approve an action?","acceptedAnswer":{"@type":"Answer","text":"Yes. Approvals can sit before a reply, order, data change or other important action. We define what the system can do on its own and what needs review."}},{"@type":"Question","name":"Which tools can you connect?","acceptedAnswer":{"@type":"Answer","text":"We start with the APIs, webhooks and integrations your tools support. Authorised browser automation can be considered when suitable. Access and platform rules are assessed during scoping."}},{"@type":"Question","name":"What happens when something fails?","acceptedAnswer":{"@type":"Answer","text":"We design timeouts, duplicate prevention, bounded retries, alerts and human handover. The right recovery path depends on the action and its risk."}},{"@type":"Question","name":"Can you guarantee a checkout or bypass CAPTCHA?","acceptedAnswer":{"@type":"Answer","text":"No. Purchasing depends on stock, approvals, payment providers and platform restrictions. CAPTCHA or access challenges are handed to an authorised person."}},{"@type":"Question","name":"How long does a project take?","acceptedAnswer":{"@type":"Answer","text":"We confirm a schedule after mapping the workflow, integrations and approval points. A focused prototype comes first, followed by the agreed build and testing scope."}}]}19:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}]
