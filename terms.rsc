1:["$","main",null,{"id":"main","className":"legal-page","children":[["$","span",null,{"className":"eyebrow","children":"LAST UPDATED / 15 NOVEMBER 2026"}],["$","h1",null,{"children":"Website terms"}],["$","p",null,{"className":"legal-note","children":"These terms explain the purpose and limitations of the examples on inn0web.com, operated by inn0web, United Kingdom. A paid project requires a separate agreed scope and contract."}],["$","h2",null,{"children":"Concepts and prototypes"}],["$","p",null,{"children":"Work labelled “Concept study” or “Interactive concept” demonstrates an original design direction or workflow. It is not presented as a completed client engagement. The Reddit interface recreates the workflow described for an internal prototype; the public demonstration uses illustrative data and does not connect to the live internal system."}],["$","h2",null,{"children":"No real transactions in demonstrations"}],["$","p",null,{"children":"Prices, orders, leads and conversations displayed in the showcases are sample data. The showcases do not post replies, send messages, purchase products, process payments or update real customer records."}],["$","h2",null,{"children":"Custom automation"}],["$","p",null,{"children":"Automation is designed for authorised accounts, data sources and actions. Integrations depend on access, technical feasibility and the rules of the relevant platform. We do not promise universal scraping, guaranteed checkout, CAPTCHA bypass or platform-control evasion."}],["$","h2",null,{"children":"Project scope and outcomes"}],["$","p",null,{"children":"Submitting an enquiry does not create a service agreement or confirm price, delivery date or business outcomes. Scope, approvals, milestones, fees, intellectual-property rights, support and acceptance criteria should be agreed in writing before work begins."}],["$","h2",null,{"children":"Brand names and original work"}],["$","p",null,{"children":"Platform names identify workflow examples only. They do not imply a partnership or endorsement. Concept brands, interface designs and campaign imagery on this site are illustrative studio work. Product demonstration recordings are credited to their publishers and show their software, not inn0web client projects."}],["$","h2",null,{"children":"Contact"}],["$","p",null,{"children":["Questions about this website can be sent to"," ",["$","a",null,{"href":"mailto:hello@inn0web.com","children":"hello@inn0web.com"}],"."]}]]}]
